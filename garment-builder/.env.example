# AI API Configuration
# Copy this file to .env and add your API keys

# OpenAI API (Primary - Best quality for garment generation)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Replicate API (Fallback - Free tier available)
VITE_REPLICATE_API_TOKEN=your_replicate_api_token_here

# Stability AI (Alternative)
VITE_STABILITY_API_KEY=your_stability_api_key_here

# Hugging Face (Free alternative)
VITE_HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# API Configuration
VITE_AI_PROVIDER=openai
VITE_IMAGE_SIZE=1024x1024
VITE_IMAGE_QUALITY=hd